<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>Assets\itchy.ico</ApplicationIcon>
    <AssemblyName>ITCHY Windows Troubleshooter</AssemblyName>
    <Version>1.4.1</Version>
    <FileVersion>1.4.1.0</FileVersion>
    <AssemblyVersion>1.4.1.0</AssemblyVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Authors>Bogazitchy</Authors>
    <Description>Windows 10/11 system diagnostics and advanced blue screen dump analysis.</Description>
    <RepositoryUrl>https://github.com/Bogazitchy/Itchy-Windows-Troubleshooter</RepositoryUrl>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="LibreHardwareMonitorLib" Version="0.9.6" />
    <Resource Include="Assets\itchy-logo.png" />
    <Resource Include="Assets\itchy.ico" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="Tests\**\*.cs" />
    <Compile Remove="Core\**\*.cs;Models\AppModels.cs;Services\WinDbgOutputParser.cs;Services\BugCheckKnowledgeBase.cs;Services\DriverClassificationService.cs;Services\DumpCorrelationService.cs;Services\CommandRunner.cs;Services\RepairScripts.cs;Services\RepairOutcomeParser.cs" />
    <ProjectReference Include="Core\Itchy.Diagnostics.Core.csproj" />
  </ItemGroup>

</Project>
