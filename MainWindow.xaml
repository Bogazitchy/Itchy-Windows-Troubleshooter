                                                    </DockPanel>
                                                    <TextBlock Foreground="{StaticResource CyanBrush}" FontSize="12" FontWeight="SemiBold" Margin="0,6,0,0" TextWrapping="Wrap">
                                                        <Run Text="{Binding Component, Mode=OneWay}"/><Run Text="  |  "/><Run Text="{Binding Role, Mode=OneWay}"/>
                                                    </TextBlock>
                                                    <TextBlock Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap">
                                                        <Run Text="Guncellik: "/><Run Text="{Binding RecencyText, Mode=OneWay}"/><Run Text="  |  Tekrar: "/><Run Text="{Binding OccurrenceCount, Mode=OneWay}"/><Run Text="  |  Bagimsiz kaynak: "/><Run Text="{Binding IndependentSourceCount, Mode=OneWay}"/>
                                                    </TextBlock>
                                                    <TextBlock Foreground="{Binding ConfidenceBrush}" FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap">
                                                        <Run Text="Kanit korelasyonu: "/><Run Text="{Binding Correlation, Mode=OneWay}"/>
                                                    </TextBlock>
                                                    <TextBlock Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap">
                                                        <Run Text="Mavi ekran iliskisi: "/><Run Text="{Binding CrashRelation, Mode=OneWay}"/>
                                                    </TextBlock>
                                                    <TextBlock Text="{Binding Cause}" Style="{StaticResource CopyableText}" Foreground="#C9D1D9" TextWrapping="Wrap" Margin="0,7,0,0"/>
                                                    <TextBlock Text="{Binding Evidence}" Style="{StaticResource CopyableText}" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,7,0,0"/>
                                                    <TextBlock Text="{Binding Recommendation}" Style="{StaticResource CopyableText}" Foreground="#C9D1D9" TextWrapping="Wrap" Margin="0,7,0,0"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>
                        </Border>
                        <Border Grid.Column="1" Style="{StaticResource Card}">
