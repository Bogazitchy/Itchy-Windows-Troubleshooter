                                <DataGrid ItemsSource="{Binding HealthChecks}" AutoGenerateColumns="False" Margin="0,10,0,0">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Zaman" Binding="{Binding ObservedAt, StringFormat=dd.MM.yyyy HH:mm:ss}" Width="150"/>
                                        <DataGridTextColumn Header="Kategori" Binding="{Binding Category}" Width="130"/>
                                        <DataGridTextColumn Header="Bilesen" Binding="{Binding Component}" Width="220"/>
                                        <DataGridTextColumn Header="Durum" Binding="{Binding Status}" Width="100"/>
                                        <DataGridTextColumn Header="Deger" Binding="{Binding Value}" Width="190"/>
                                        <DataGridTextColumn Header="Kanit / Aciklama" Binding="{Binding Detail}" Width="*"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </TabItem>
                            <TabItem Header="Tarama Kapsami">
                                <DataGrid ItemsSource="{Binding ScanCoverage}" AutoGenerateColumns="False" Margin="0,10,0,0">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Veri Kaynagi" Binding="{Binding Source}" Width="230"/>
                                        <DataGridTextColumn Header="Durum" Binding="{Binding Status}" Width="120"/>
                                        <DataGridTextColumn Header="Kayit" Binding="{Binding RecordCount}" Width="80"/>
                                        <DataGridTextColumn Header="Kapsam Detayi" Binding="{Binding Detail}" Width="*"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </TabItem>
                            <TabItem Header="Ham Olay Kayitlari">
                                <DataGrid ItemsSource="{Binding EventItems}" AutoGenerateColumns="False" Margin="0,10,0,0">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Zaman" Binding="{Binding TimeCreated, StringFormat=dd.MM.yyyy HH:mm:ss}" Width="150"/>
                                        <DataGridTextColumn Header="Log" Binding="{Binding LogName}" Width="150"/>
                                        <DataGridTextColumn Header="Kaynak" Binding="{Binding Provider}" Width="210"/>
                                        <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="70"/>
                                        <DataGridTextColumn Header="Seviye" Binding="{Binding Level}" Width="100"/>
                                        <DataGridTextColumn Header="Mesaj" Binding="{Binding Message}" Width="*"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </TabItem>
                        </TabControl>
                    </Grid>
                </TabItem>

                <TabItem Header="Güvenilirlik">
                    <Grid Margin="0,14,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Performans ve Guvenilirlik" Style="{StaticResource SectionTitle}"/>
                                <TextBlock Text="Reliability Monitor kayitlari Win32_ReliabilityRecords ile okunur. Erisim kapaliysa hata acikca gosterilir." Style="{StaticResource MutedText}"/>
                                <WrapPanel Margin="0,12,0,0">
                                    <Button Content="Guvenilirlik Verilerini Oku" Click="Reliability_Click" Style="{StaticResource PrimaryButton}"/>

                                </WrapPanel>
                            </StackPanel>
                        </Border>
                        <DataGrid Grid.Row="1" ItemsSource="{Binding ReliabilityItems}" AutoGenerateColumns="False">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Zaman" Binding="{Binding TimeGenerated, StringFormat=dd.MM.yyyy HH:mm:ss}" Width="160"/>
                                <DataGridTextColumn Header="Kaynak" Binding="{Binding SourceName}" Width="180"/>
                                <DataGridTextColumn Header="Urun" Binding="{Binding ProductName}" Width="180"/>
                                <DataGridTextColumn Header="Ozet" Binding="{Binding Message}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </TabItem>

                <TabItem Header="Sistem Koruma">
                    <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                        <StackPanel>
                            <TextBlock Text="Sistem Koruma ve Geri Yukleme" Style="{StaticResource SectionTitle}"/>
                            <TextBlock Text="{Binding ProtectionStatus}" Style="{StaticResource CopyableText}" TextWrapping="Wrap" Foreground="#C9D1D9"/>
                            <WrapPanel Margin="0,14,0,0">
                                <Button Content="Durumu Yenile" Click="Protection_Click" Style="{StaticResource PrimaryButton}"/>
                                <Button Content="Geri Yukleme Noktasi Olustur" Click="CreateRestorePoint_Click"/>
                                <Button Content="Sistem Koruma Ayarlarini Ac" Click="OpenProtection_Click"/>

                            </WrapPanel>
                            <DataGrid ItemsSource="{Binding RestorePoints}" AutoGenerateColumns="False" Height="360">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Tarih" Binding="{Binding CreatedAt, StringFormat=dd.MM.yyyy HH:mm:ss}" Width="180"/>
                                    <DataGridTextColumn Header="Aciklama" Binding="{Binding Description}" Width="*"/>
                                    <DataGridTextColumn Header="Tip" Binding="{Binding Type}" Width="150"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Border>
                </TabItem>

                <TabItem Header="Onarım Araçları">
                    <ScrollViewer Margin="0,14,0,0" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="Sistem koruma" Style="{StaticResource SectionTitle}"/>
                            <TextBlock Text="{Binding ProtectionStatus}" TextWrapping="Wrap" Margin="0,0,0,12"/>
                            <WrapPanel>
                                <Button Content="Koruma durumunu yenile" Click="Protection_Click"/>
                                <Button Content="Geri yükleme noktası oluştur" Click="CreateRestorePoint_Click"/>
                            </WrapPanel>
                            <TextBlock Text="CHKDSK hedef birimi" Margin="0,8,0,4"/>
                            <ComboBox ItemsSource="{Binding DiskDrives}" SelectedItem="{Binding SelectedDrive}" Width="140" HorizontalAlignment="Left" Margin="0,0,0,12"/>
                            <WrapPanel>
                            <Button Content="SFC Taramasi" Tag="sfc" Click="Repair_Click"/>
                            <Button Content="DISM CheckHealth" Tag="dism-check" Click="Repair_Click"/>
                            <Button Content="DISM ScanHealth" Tag="dism-scan" Click="Repair_Click"/>
                            <Button Content="DISM RestoreHealth" Tag="dism-restore" Click="Repair_Click"/>
                            <Button Content="CHKDSK Kontrolu" Tag="chkdsk-scan" Click="Repair_Click"/>
                            <Button Content="CHKDSK /f onarım" Tag="chkdsk-repair" Click="Repair_Click"/>
                            <Button Content="CHKDSK /r yüzey taraması" Tag="chkdsk-surface" Click="Repair_Click"/>
                            <Button Content="Windows Update Reset" Tag="wu-reset" Click="Repair_Click"/>
                            <Button Content="Ag Onarimi" Tag="network-reset" Click="Repair_Click"/>
                            <Button Content="DNS Temizle" Tag="dns" Click="Repair_Click"/>
                            <Button Content="Windows Store Cache Reset" Tag="store" Click="Repair_Click"/>
                            <Button Content="Defender Hizli Tarama" Tag="defender" Click="Repair_Click"/>
                            <Button Content="Gecici Dosya Temizleme" Tag="temp" Click="Repair_Click"/>
                            <Button Content="Yazici Spooler Onarimi" Tag="spooler" Click="Repair_Click"/>
                        </WrapPanel>
                    </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="Kısayollar">
                    <ScrollViewer Margin="0,14,0,0">
                        <ItemsControl ItemsSource="{Binding Shortcuts}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource Card}" Width="250" MinHeight="152">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="*"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <TextBlock Grid.Row="0" Text="{Binding Name}" FontWeight="Bold" FontSize="15"/>
                                            <TextBlock Grid.Row="1" Text="{Binding Description}" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,8,0,12"/>
                                            <Button Grid.Row="2" Content="Ac" Tag="{Binding}" Click="Shortcut_Click" HorizontalAlignment="Left" MinWidth="72"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="Raporlar">
                    <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                        <StackPanel>
                            <TextBlock Text="Raporlama" Style="{StaticResource SectionTitle}"/>
                            <TextBlock Text="HTML ve TXT raporlar kullanici ozeti ve teknik detaylari birlikte icerir." Style="{StaticResource MutedText}"/>

                            <TextBlock Text="{Binding ReportPath}" Style="{StaticResource CopyableText}" TextWrapping="Wrap" Foreground="#C9D1D9" Margin="0,14,0,0"/>
                        </StackPanel>
                    </Border>
                </TabItem>

                <TabItem Header="Ayarlar">
                    <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                        <StackPanel>
                            <TextBlock Text="Ayarlar" Style="{StaticResource SectionTitle}"/>
                            <Border Background="#FFFFFF" CornerRadius="6" Width="200" Height="200" HorizontalAlignment="Left" Margin="0,0,0,16">
                                <Image Source="Assets/itchy-logo.png" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" AutomationProperties.Name="ITCHY Windows Troubleshooter logosu"/>
                            </Border>
                            <TextBlock Text="ITCHY yerel analiz, kontrollu onarim ve teknisyen raporlama odakli calisir." Style="{StaticResource MutedText}"/>
                            <TextBlock Text="Guvenlik siniri: Registry cleaner, sahte hizlandirma ve onaysiz kritik islem yoktur." Foreground="#C9D1D9" Margin="0,12,0,0"/>
                        </StackPanel>
                    </Border>
                </TabItem>
            </TabControl>
        </Grid>
    </Grid>
</Window>
